# /etc/gjallarhorn/probe.env – Einstellungen der Horn-Probe (Beispiel)
# Name, unter dem Browser die Probe erreichen (DNS zeigt auf den Proxy bzw. Host)
HORN_NAME=probe.example.org
# Lauschadresse. Ohne Root z. B. :5349; der Proxy reicht 443 per SNI hierher durch.
HORN_LISTEN=:5349
# UDP auf demselben Port (1 = an, 0 = aus). Hinter einem reinen TLS-Proxy: 0
HORN_UDP=0
# Zertifikat aus Dateien (bei Aenderung automatisch neu geladen, sonst
# "systemctl reload gjallarhorn-probe"). Die Dateien muss der Benutzer
# gjallarhorn lesen koennen.
HORN_TLS_CERT=/etc/gjallarhorn/tls/fullchain.pem
HORN_TLS_KEY=/etc/gjallarhorn/tls/privkey.pem
# PROXY-Protokoll v2 vom vorgeschalteten Proxy: 0 (Standard), 1 (Pflicht), auto
HORN_PROXY_PROTOCOL=0
# Oeffentliche Adresse fuer ICE-TCP/UDP-Kandidaten (leer = aus HORN_NAME ermitteln)
#HORN_PUBLIC_IP=192.0.2.10
