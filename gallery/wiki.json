    {"ref": "schreiben", "kind": "page", "parent": "home", "title": "Wie man hier schreibt", "icon": "✍️",
     "body": [
       {"type": "callout", "data": {"emoji": "💡", "text": "Gute Wiki-Seiten sind kurz, aktuell und leicht zu überfliegen."}},
       {"type": "header", "data": {"text": "Fünf Regeln", "level": 2}},
       {"type": "list", "data": {"style": "ordered", "meta": {}, "items": [
         {"content": "<b>Das Wichtigste zuerst</b> – die Antwort steht im ersten Absatz.", "meta": {}, "items": []},
         {"content": "<b>Kurze Abschnitte</b> mit Überschriften, Details in ausklappbaren Blöcken.", "meta": {}, "items": []},
         {"content": "<b>Schritte nummerieren</b>, Aufzählungen für alles ohne Reihenfolge.", "meta": {}, "items": []},
         {"content": "<b>Verlinken statt kopieren</b>: Mit „[[“ verweist du auf eine andere Seite.", "meta": {}, "items": []},
         {"content": "<b>Aktuell halten</b>: Veraltetes löschen – alte Fassungen bleiben in den Versionen.", "meta": {}, "items": []}]}},
       {"type": "header", "data": {"text": "Bausteine", "level": 2}},
       {"type": "paragraph", "data": {"text": "Tippe <code class=\"inline-code\">/</code> für Blöcke: Überschrift, Hinweis, Ausklappbar, Tabelle, Checkliste, Spalten und mehr."}},
       {"type": "callout", "data": {"emoji": "⚠️", "text": "Hinweis-Blöcke sparsam einsetzen – nur für Dinge, die man nicht übersehen darf."}},
       {"type": "quote", "data": {"text": "Schreib so, dass die neue Kollegin es am ersten Tag versteht.", "caption": "", "alignment": "left"}}
     ]}
  ]
