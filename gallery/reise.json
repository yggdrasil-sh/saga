         {"blocks": [
           {"type": "header", "data": {"text": "Kleidung", "level": 3}},
           {"type": "list", "data": {"style": "checklist", "meta": {}, "items": [
             {"content": "Wetterfeste Jacke", "meta": {"checked": false}, "items": []},
             {"content": "Bequeme Schuhe", "meta": {"checked": false}, "items": []},
