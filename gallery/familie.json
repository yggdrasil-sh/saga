    {"ref": "erinnerungen", "kind": "database", "parent": "home", "title": "Erinnerungen", "icon": "📸",
     "schema": {
       "title_name": "Erinnerung",
       "props": [
         {"id": "datum", "name": "Datum", "type": "date"},
         {"id": "art", "name": "Anlass", "type": "select", "options": [
           {"id": "fest", "name": "Fest", "color": "pink"},
           {"id": "reise", "name": "Reise", "color": "blue"},
           {"id": "meilenstein", "name": "Meilenstein", "color": "purple"},
           {"id": "tradition", "name": "Tradition", "color": "orange"},
           {"id": "alltag", "name": "Alltag", "color": "gray"}]},
         {"id": "ort", "name": "Ort", "type": "text"},
         {"id": "personen", "name": "Mit dabei", "type": "relation", "target": "$ref:personen", "two_way": true}
       ],
       "views": [
         {"id": "galerie", "name": "Galerie", "type": "gallery", "card": "l", "sorts": [{"pid": "datum", "dir": "desc"}],
          "hidden": ["ort", "personen"]},
         {"id": "zeitleiste", "name": "Zeitleiste", "type": "timeline", "date_by": "datum"},
         {"id": "anlass", "name": "Nach Anlass", "type": "board", "group_by": "art", "sorts": [{"pid": "datum", "dir": "desc"}]},
         {"id": "tabelle", "name": "Tabelle", "type": "table", "sorts": [{"pid": "datum", "dir": "desc"}]}
       ],
       "default_tpl": "$ref:tpl_erinnerung"
     },
     "templates": [
       {"ref": "tpl_erinnerung", "title": "Neue Erinnerung", "icon": "📸", "props": {}, "default": true,
        "body": [
          {"type": "callout", "data": {"emoji": "🖼️", "text": "Füge hier Fotos ein – das erste Bild wird zum Kartenbild in der Galerie."}},
          {"type": "header", "data": {"text": "Was ist passiert?", "level": 2}},
          {"type": "paragraph", "data": {"text": ""}},
          {"type": "header", "data": {"text": "Schönster Moment", "level": 2}},
          {"type": "quote", "data": {"text": "", "caption": "", "alignment": "left"}}
        ]}
     ],
     "rows": [
       {"ref": "e_hochzeit", "title": "Goldene Hochzeit von Helga und Karl", "icon": "💛", "example": true,
        "props": {"datum": "2021-06-12", "art": "fest", "ort": "Gasthof am See",
                  "personen": ["$ref:p_helga", "$ref:p_karl", "$ref:p_julia", "$ref:p_markus", "$ref:p_lena", "$ref:p_paul"]},
        "body": [
          {"type": "callout", "data": {"emoji": "🖼️", "text": "Hier die schönsten Fotos des Tages einfügen."}},
          {"type": "header", "data": {"text": "Was ist passiert?", "level": 2}},
          {"type": "paragraph", "data": {"text": "Fünfzig Jahre verheiratet! Die ganze Familie kam zusammen, Lena und Paul haben ein Gedicht aufgesagt und Opa Karl hat zum ersten Mal seit Jahren getanzt."}},
          {"type": "header", "data": {"text": "Schönster Moment", "level": 2}},
          {"type": "quote", "data": {"text": "Das Geheimnis? Jeden Tag ein bisschen lachen – und abends nie im Streit einschlafen.", "caption": "Oma Helga", "alignment": "left"}}
        ]},
       {"ref": "e_see", "title": "Sommer am See", "icon": "⛵", "example": true,
        "props": {"datum": "2025-08-03", "art": "reise", "ort": "Bergsee",
                  "personen": ["$ref:p_julia", "$ref:p_markus", "$ref:p_lena", "$ref:p_paul"]}},
       {"ref": "e_schule", "title": "Lenas Einschulung", "icon": "🎒", "example": true,
        "props": {"datum": "2021-09-04", "art": "meilenstein", "ort": "Grundschule",
                  "personen": ["$ref:p_lena", "$ref:p_julia", "$ref:p_markus", "$ref:p_helga"]}},
       {"ref": "e_plaetzchen", "title": "Plätzchenbacken bei Oma", "icon": "🍪", "example": true,
        "props": {"datum": "2025-12-20", "art": "tradition", "ort": "Haus am Waldrand",
                  "personen": ["$ref:p_helga", "$ref:p_lena", "$ref:p_paul"]}}
     ]},

    {"ref": "anleitung", "kind": "page", "parent": "home", "title": "So funktioniert's", "icon": "🧭", "cover": null,
     "body": [
       {"type": "callout", "data": {"emoji": "🌱", "text": "Die Beispielfamilie Berger zeigt, wie alles zusammenhängt. Lösche sie, sobald du deine eigene Familie eingetragen hast."}},
       {"type": "header", "data": {"text": "👤 Personen eintragen", "level": 2}},
       {"type": "list", "data": {"style": "ordered", "meta": {}, "items": [
         {"content": "Auf der Startseite „Person hinzufügen“ wählen und den Namen eintragen.", "meta": {}, "items": []},
         {"content": "Generation, Geburtstag und Wohnort setzen – Alter und nächster Geburtstag rechnet Saga selbst aus.", "meta": {}, "items": []},
         {"content": "Bei „Eltern“ und „Partner/in“ die passenden Personen auswählen. So entsteht Schritt für Schritt euer Stammbaum.", "meta": {}, "items": []}]}},
       {"type": "header", "data": {"text": "📷 Fotos", "level": 2}},
       {"type": "list", "data": {"style": "unordered", "meta": {}, "items": [
         {"content": "Ein Titelbild oder das erste Bild auf der Seite einer Person erscheint als Karte in der Ansicht „Familie“.", "meta": {}, "items": []},
         {"content": "Fotos aus der Nextcloud holst du mit „/“ → Nextcloud direkt in eine Seite.", "meta": {}, "items": []}]}},
       {"type": "header", "data": {"text": "📸 Erinnerungen", "level": 2}},
       {"type": "paragraph", "data": {"text": "Feste, Reisen und kleine Alltagsmomente bekommen eine eigene Seite. Unter „Mit dabei“ wählst du die Personen – bei ihnen erscheint die Erinnerung dann automatisch."}},
       {"type": "header", "data": {"text": "🔒 Privatsphäre", "level": 2}},
       {"type": "paragraph", "data": {"text": "Das Familien-Wiki ist zuerst nur für dich sichtbar. Über „Teilen“ lädst du gezielt Familienmitglieder ein – zum Lesen oder Mitschreiben."}}
     ]}
  ]
}
