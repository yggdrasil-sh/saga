          {"type": "toggle", "data": {"title": "Liebe und Familie", "level": 3, "open": false, "blocks": [
            {"type": "paragraph", "data": {"text": ""}}]}},
          {"type": "header", "data": {"text": "💬 Was man sich erzählt", "level": 2}},
          {"type": "quote", "data": {"text": "", "caption": "", "alignment": "left"}}
        ]}
     ],
     "rows": [
