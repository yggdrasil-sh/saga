                {"content": "Lebensmotto: ", "meta": {}, "items": []}]}}]},
            {"blocks": [
              {"type": "header", "data": {"text": "🏡 Lebensstationen", "level": 3}},
              {"type": "list", "data": {"style": "unordered", "meta": {}, "items": [
                {"content": "", "meta": {}, "items": []}]}}]}
          ]}},
          {"type": "header", "data": {"text": "📖 Lebensgeschichte", "level": 2}},
          {"type": "toggle", "data": {"title": "Kindheit und Jugend", "level": 3, "open": true, "blocks": [
            {"type": "paragraph", "data": {"text": ""}}]}},
          {"type": "toggle", "data": {"title": "Beruf und Leidenschaften", "level": 3, "open": false, "blocks": [
