  "items": [
    {"ref": "home", "kind": "page", "parent": null, "title": "Familien-Wiki", "icon": "🌳", "cover": null, "wide": true,
     "body": [
       {"type": "callout", "data": {"emoji": "🌳", "text": "Willkommen in unserer Familiengeschichte! Hier sammeln wir die Menschen, die uns wichtig sind – mit Geburtstagen, Fotos, Geschichten und gemeinsamen Erinnerungen."}},
       {"type": "columns", "data": {"cols": [
         {"w": 0.22, "blocks": [{"id": "wfam01", "type": "widget", "data": {"v": 1, "kind": "metric", "size": "s", "style": "card", "accent": "green", "title": "Familienmitglieder",
                      "cfg": {"db": "$ref:personen", "view": "alle", "agg": "count", "prop": "", "fmt": "num"}}}]},
         {"w": 0.22, "blocks": [{"id": "wfam02", "type": "widget", "data": {"v": 1, "kind": "metric", "size": "s", "style": "card", "accent": "orange", "title": "Erinnerungen",
                      "cfg": {"db": "$ref:erinnerungen", "view": "tabelle", "agg": "count", "prop": "", "fmt": "num"}}}]},
         {"w": 0.22, "blocks": [{"id": "wfam03", "type": "widget", "data": {"v": 1, "kind": "metric", "size": "s", "style": "card", "accent": "purple", "title": "Geburtstage in 60 Tagen",
                      "cfg": {"db": "$ref:personen", "view": "geburtstage", "agg": "count", "prop": "", "fmt": "num"}}}]},
         {"w": 0.34, "blocks": [{"id": "wfam04", "type": "widget", "data": {"v": 1, "kind": "quote", "size": "m", "style": "card", "accent": "pink", "title": "Familien-Gedanke",
                      "cfg": {"src": "fixed", "pick": "daily", "items": [
                        "Wurzeln geben Halt, Zweige geben Freiheit.",
                        "Jede Familie hat Geschichten, die es wert sind, weitererzählt zu werden.",
                        "Wer weiß, woher er kommt, findet leichter seinen Weg.",
                        "Erinnerungen sind das Band zwischen den Generationen.",
                        "Am Küchentisch entstehen die schönsten Familiengeschichten."]}}}]}
       ]}},
       {"type": "buttons", "data": {"buttons": [
         {"label": "Person hinzufügen", "icon": "👤", "action": "db", "target": "$ref:personen", "tpl": "$ref:tpl_person", "title": "", "open": ""},
         {"label": "Erinnerung festhalten", "icon": "📸", "action": "db", "target": "$ref:erinnerungen", "tpl": "$ref:tpl_erinnerung", "title": "", "open": ""},
         {"label": "So funktioniert's", "icon": "🧭", "action": "page", "target": "$ref:anleitung", "open": "side"}
       ]}},
       {"type": "columns", "data": {"cols": [
         {"w": 0.5, "blocks": [
           {"type": "header", "data": {"text": "🎂 Nächste Geburtstage", "level": 2}},
           {"type": "database", "data": {"db": "$ref:personen", "view": "geburtstage", "views": null, "hide_title": true}}]},
         {"w": 0.5, "blocks": [
           {"type": "header", "data": {"text": "📸 Neueste Erinnerungen", "level": 2}},
           {"type": "database", "data": {"db": "$ref:erinnerungen", "view": "galerie", "views": null, "hide_title": true}}]}
       ]}},
       {"type": "header", "data": {"text": "🌳 Unsere Familie nach Generationen", "level": 2}},
       {"type": "database", "data": {"db": "$ref:personen", "view": "generationen", "views": null, "hide_title": true}},
       {"type": "header", "data": {"text": "👨‍👩‍👧‍👦 Alle Familienmitglieder", "level": 2}},
       {"type": "database", "data": {"db": "$ref:personen", "view": "familie", "views": null, "hide_title": true}}
     ]},

    {"ref": "personen", "kind": "database", "parent": "home", "title": "Familienmitglieder", "icon": "👨‍👩‍👧‍👦",
     "schema": {
       "title_name": "Name",
       "props": [
         {"id": "generation", "name": "Generation", "type": "select", "options": [
           {"id": "urgross", "name": "Urgroßeltern", "color": "brown"},
           {"id": "gross", "name": "Großeltern", "color": "purple"},
           {"id": "eltern_g", "name": "Eltern", "color": "blue"},
           {"id": "kinder_g", "name": "Kinder", "color": "green"},
           {"id": "enkel", "name": "Enkel", "color": "yellow"}]},
         {"id": "spitzname", "name": "Wird genannt", "type": "text"},
         {"id": "geboren", "name": "Geboren", "type": "date"},
         {"id": "gestorben", "name": "Verstorben", "type": "date"},
         {"id": "alter", "name": "Alter", "type": "formula",
          "expr": "dateBetween(if(empty(prop(\"gestorben\")), today(), prop(\"gestorben\")), prop(\"geboren\"), \"years\")"},
         {"id": "naechster", "name": "Nächster Geburtstag", "type": "formula",
          "expr": "if(and(equal(month(prop(\"geboren\")), month(today())), equal(day(prop(\"geboren\")), day(today()))), today(), dateAdd(prop(\"geboren\"), dateBetween(today(), prop(\"geboren\"), \"years\") + 1, \"years\"))"},
         {"id": "wird", "name": "Wird", "type": "formula",
          "expr": "if(and(equal(month(prop(\"geboren\")), month(today())), equal(day(prop(\"geboren\")), day(today()))), dateBetween(today(), prop(\"geboren\"), \"years\"), dateBetween(today(), prop(\"geboren\"), \"years\") + 1)"},
         {"id": "tage", "name": "Noch (Tage)", "type": "formula",
          "expr": "if(and(equal(month(prop(\"geboren\")), month(today())), equal(day(prop(\"geboren\")), day(today()))), 0, dateBetween(dateAdd(prop(\"geboren\"), dateBetween(today(), prop(\"geboren\"), \"years\") + 1, \"years\"), today(), \"days\"))"},
         {"id": "geburtsort", "name": "Geburtsort", "type": "text"},
         {"id": "wohnort", "name": "Wohnt in", "type": "text"},
         {"id": "beruf", "name": "Beruf", "type": "text"},
         {"id": "eltern", "name": "Eltern", "type": "relation", "target": "$ref:personen"},
         {"id": "partner", "name": "Partner/in", "type": "relation", "target": "$ref:personen"},
         {"id": "zweig", "name": "Familienzweig", "type": "multi_select", "options": [
           {"id": "mutter", "name": "Mütterlicherseits", "color": "pink"},
           {"id": "vater", "name": "Väterlicherseits", "color": "blue"},
           {"id": "angeheiratet", "name": "Angeheiratet", "color": "orange"}]}
       ],
       "views": [
         {"id": "familie", "name": "Familie", "type": "gallery", "card": "l", "sorts": [{"pid": "geboren", "dir": "asc"}],
          "hidden": ["alter", "gestorben", "naechster", "wird", "tage", "geburtsort", "wohnort", "beruf", "eltern", "partner", "zweig"],
          "colors": [{"pid": "generation", "op": "is", "value": "urgross", "color": "brown"},
                     {"pid": "generation", "op": "is", "value": "gross", "color": "purple"},
                     {"pid": "generation", "op": "is", "value": "eltern_g", "color": "blue"},
                     {"pid": "generation", "op": "is", "value": "kinder_g", "color": "green"},
                     {"pid": "generation", "op": "is", "value": "enkel", "color": "yellow"}]},
         {"id": "generationen", "name": "Generationen", "type": "board", "group_by": "generation", "sorts": [{"pid": "geboren", "dir": "asc"}],
          "hidden": ["generation", "gestorben", "naechster", "wird", "tage", "geburtsort", "wohnort", "beruf", "eltern", "zweig"],
          "colors": [{"pid": "gestorben", "op": "not_empty", "value": "", "color": "gray"}]},
         {"id": "geburtstage", "name": "Geburtstage", "type": "table",
          "filters": [{"pid": "geboren", "op": "not_empty", "value": ""}, {"pid": "gestorben", "op": "is_empty", "value": ""},
                      {"pid": "tage", "op": "lt", "value": "60"}],
          "sorts": [{"pid": "tage", "dir": "asc"}],
          "hidden": ["generation", "spitzname", "geboren", "gestorben", "alter", "geburtsort", "wohnort", "beruf", "eltern", "partner", "zweig"]},
         {"id": "alle", "name": "Alle (Tabelle)", "type": "table", "sorts": [{"pid": "geboren", "dir": "asc"}]},
         {"id": "kalender", "name": "Geburtstage im Jahr", "type": "table",
          "filters": [{"pid": "geboren", "op": "not_empty", "value": ""}, {"pid": "gestorben", "op": "is_empty", "value": ""}],
          "sorts": [{"pid": "tage", "dir": "asc"}],
          "hidden": ["spitzname", "gestorben", "alter", "geburtsort", "beruf", "eltern", "partner", "zweig"]}
       ],
       "default_tpl": "$ref:tpl_person"
     },
     "templates": [
       {"ref": "tpl_person", "title": "Neue Person", "icon": "🙂", "props": {}, "default": true,
        "body": [
          {"type": "callout", "data": {"emoji": "📷", "text": "Tipp: Füge ein Foto als Titelbild oder hier im Text ein – es erscheint dann auf der Karte in „Familie“. Bilder aus der Nextcloud holst du mit „/“ → Nextcloud."}},
          {"type": "columns", "data": {"cols": [
