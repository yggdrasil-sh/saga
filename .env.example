# Saga - Konfiguration (cp .env.example .env)
# Alles rund um Anmeldung (lokale Konten, Registrierung, SSO/OIDC, LDAP/AD), Gruppen und Dienste
# stellst du im Admin-Bereich ein - hier stehen nur Dinge, die vor dem Start feststehen muessen.

# Oeffentliche Adresse der Hauptseite (so, wie Benutzer sie aufrufen; ohne / am Ende)
BASE_URL=https://saga.example.org
# Adresse des Admin-Bereichs - nur fuer den Link im Benutzermenue (optional)
ADMIN_URL=http://127.0.0.1:8081

# Geheimer Schluessel (Sitzungen, verschluesselte Zugangsdaten): openssl rand -hex 32
# NICHT aendern, sonst sind gespeicherte Kalender-/Immich-/LDAP-/SSO-Geheimnisse unlesbar.
SECRET_KEY=CHANGEME

# Datenbank (Container "db")
POSTGRES_PASSWORD=CHANGEME
POSTGRES_USER=saga
POSTGRES_DB=saga

# Erster Admin - wird nur angelegt, wenn es noch keinen gibt.
# Ohne (gueltiges, mind. 10 Zeichen) Passwort wird eines erzeugt und im Log ausgegeben:
#   docker compose logs saga | grep Admin-Konto
# Vergessen/Logs weg: docker compose exec saga python run.py admin-passwort
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Ports auf dem Host
HOST_BIND=0.0.0.0
HOST_PORT=8080
# Admin-Bereich nur lokal/SSH-Tunnel. Fuer LAN-Zugriff z. B. 192.168.1.10
ADMIN_BIND=127.0.0.1
ADMIN_HOST_PORT=8081

# Reverse Proxy davor (Caddy, Traefik, nginx ...): dessen IP(s), damit echte Client-Adressen ankommen
TRUSTED_PROXIES=127.0.0.1
# Aufrufe ueber andere Hostnamen auf BASE_URL umleiten (false fuer reine LAN-/Testbetriebe)
CANONICAL_REDIRECT=true
# Eigene Domains nur fuer oeffentliche Seiten (Veroeffentlichen), Komma-getrennt - dort gibt es "/", /@... und /static/
#PUBLIC_HOSTS=blog.example.org
# Aufrufe oeffentlicher Seiten je IP-Adresse und Minute (Bilder: das Fuenffache) - zaehlt nur richtig mit passendem TRUSTED_PROXIES
#PUBLIC_RATE=120

# Version: 2 = immer die neueste 2.x (Updates: docker compose pull && docker compose up -d),
# 2.0.0 = genau diese Version. Vor jedem Datenbank-Update legt Saga ein Backup in /data/backups an.
SAGA_VERSION=2
# Backups behalten (Anzahl); Hinweis auf neue Versionen im Admin-Bereich (auch dort abschaltbar)
#BACKUP_KEEP=10
#SAGA_UPDATE_CHECK=1
# Verschluesselte Backups (S3, Ordner im Container, Nextcloud/WebDAV) richtest du im Admin-Bereich ein (Backups).
# Ordner-Ziel: nur unterhalb dieser Wurzeln (Komma-Liste; Volume in docker-compose.yml einbinden, siehe docs/ANLEITUNG.md)
#SAGA_BACKUP_DIRS=/backup
# Testwiederherstellung auf einem zweiten Server: SAGA_RESTORE_TEST=1 = keine ausgehenden Verbindungen zu den Diensten
# der echten Instanz (Foederation, Mitteilungen, Backups, Kalender, KI, Immich, Websuche, Avatare).
#SAGA_RESTORE_TEST=1

# Optional
TIMEZONE=Europe/Berlin
# Browser-Sitzung in Stunden; Apps bleiben dauerhaft angemeldet
SESSION_HOURS=12
# Vorschlag im Immich-Dialog
#IMMICH_URL=https://immich.example.org
# leer = Dienst-Symbole nicht aus dem Internet laden
#ICON_CDN=
#ATTACH_MAX_MB=10
#ATTACH_QUOTA_MB=500
# Profilbild hochladen: groesste Datei in MB
#AVATAR_MAX_MB=5
# Groesste Anfrage ausser Datei-Uploads in MB (z. B. sehr lange Seiten); groessere bekommen 413.
# Im Reverse Proxy zusaetzlich eine Grenze etwas ueber ATTACH_MAX_MB setzen (nginx: client_max_body_size 12m)
#REQUEST_MAX_MB=2
# Passwortpruefungen gleichzeitig (je ca. 32 MB Speicher); weitere warten bis 2 s, dann "gleich noch einmal versuchen"
#KDF_PARALLEL=4
# Hinweis: Kalender (CalDAV) und Immich verbinden direkt, nicht ueber HTTPS_PROXY/HTTP_PROXY (Schutz des internen Netzes)

# Websuche (SearXNG, optional)
#COMPOSE_PROFILES=search
#SEARXNG_URL=http://searxng:8080
# openssl rand -hex 32
#SEARXNG_SECRET=CHANGEME
